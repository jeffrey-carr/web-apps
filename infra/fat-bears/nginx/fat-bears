map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    server_name fatbears.jeffreycarr.dev www.fatbears.jeffreycarr.dev;

    # Set the maximum allowed size of the client request body
    client_max_body_size 10M;

    location / {
        proxy_pass http://localhost:3003;  # fat_bears_frontend
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /api/ {
        proxy_pass http://localhost:3103;  # fat_bears_backend
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
    }

    # TEMPORARILY COMMENTED OUT FOR INITIAL SETUP
